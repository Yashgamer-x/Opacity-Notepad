<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<fx:root alignment="CENTER_LEFT"
         spacing="8.0" styleClass="find-bar"
         type="HBox" xmlns="http://javafx.com/javafx/26"
         xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="6.0" left="12.0" right="12.0" top="6.0" />
    </padding>
    <TextField fx:id="searchField" prefWidth="200.0" promptText="Find..." styleClass="find-text-field" />

    <Button fx:id="findNextButton" mnemonicParsing="false" styleClass="find-button">
        <graphic>
            <FontIcon iconLiteral="fas-arrow-down" styleClass="find-icon" />
        </graphic>
        <tooltip>
            <Tooltip text="Next match" />
        </tooltip>
    </Button>

    <Button fx:id="findPreviousButton" mnemonicParsing="false" styleClass="find-button">
        <graphic>
            <FontIcon iconLiteral="fas-arrow-up" styleClass="find-icon" />
        </graphic>
        <tooltip>
            <Tooltip text="Previous match" />
        </tooltip>
    </Button>

    <Button fx:id="closeButton" mnemonicParsing="false" styleClass="find-close-button">
        <graphic>
            <FontIcon iconLiteral="fas-times" styleClass="find-close-icon" />
        </graphic>
        <tooltip>
            <Tooltip text="Close find bar" />
        </tooltip>
    </Button>
</fx:root>